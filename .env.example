# Vercel production: use the project Environment Variables UI. Never put these in browser code.
AFTERGLOW_SETUP_KEY=replace-with-a-long-random-server-setup-key
# Added automatically by an Upstash Redis integration (custom prefixes should be mapped to these names):
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=replace-with-your-private-redis-rest-token
# The UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN names also work.
# Optional exact production origin. Leave unset for Vercel preview domains to work too.
# PUBLIC_ORIGIN=https://your-domain.example
# Local standalone server options (no Redis needed):
# HOST=0.0.0.0
# PORT=4173
# AFTERGLOW_DATA_DIR=/absolute/path/to/private/show-data
# Approved guest album. Defaults to the existing Firebase photo app; no keys required.
# PHOTOS_ORIGIN=https://priya-gautam-photos.web.app
# For the local synthetic photo demo only: PHOTOS_ORIGIN=http://127.0.0.1:4312
